{
  "name": "aiderdesk-agent-bus",
  "version": "0.2.1",
  "description": "Multi-agent team orchestration for AiderDesk on top of agent-bus",
  "main": "index.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "aiderdesk",
    "extension",
    "agent-bus",
    "multi-agent"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aiderdesk/extensions": "^0.42.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "sync": "rsync -a --exclude node_modules --exclude .git --exclude dist --exclude reports --exclude .stryker-tmp ./ ~/.aider-desk/extensions/aiderdesk-agent-bus/",
    "test:watch": "vitest",
    "mutate:wakeup": "stryker run",
    "mutate:state": "stryker run --mutate src/core/state.ts",
    "mutate:config": "stryker run --mutate src/core/config.ts"
  }
}
