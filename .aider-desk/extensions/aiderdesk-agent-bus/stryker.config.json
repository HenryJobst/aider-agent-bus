{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/orchestration/wakeup.ts"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/wakeup.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/wakeup.json"
  },
  "timeoutMS": 15000,
  "concurrency": 2,
  "ignoreStatic": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
